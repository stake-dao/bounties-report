# Directories
node_modules/
tmp/
.tmp/
venv/
.nodeenv/
temp/
.claude/settings.local.json
.cache/
.tmp/

# Envio
script/indexer/vlcvx-forwarder/generated/

# TypeScript compiled output (project uses tsx, never emit .js in-place)
script/**/*.js
script/**/*.d.ts

# Files
.DS_Store
.env
.vscode/settings.json

# Files to ignore
package-lock.json
yarn.lock

AGENTS.md
CLAUDE.md

# Test snapshots (large golden files - capture locally per machine)
script/test/snapshots/golden/

# vlcvx-diagnose runtime cache (regenerated each run)
data/votium-rounds-cache.json
script/vlCVX/recovery_apr21_doubling/fork_simulation_report.json

# Local fork/vnet test scripts (kept locally, never pushed)
*.tmp.ts

# vpBreakdown verify tool output (ad-hoc, must not ride along pipeline commits)
bounties-reports/*/vlCVX/vp_breakdown.json

# Local forecast archive for round 128 (dry-run inputs/outputs kept for comparison)
.forecast-round128/

# Union reassignment outputs (regenerated from chain and Snapshot on every run).
# The end-user split is kept: it is the reviewable deliverable, and it must
# reconcile with the Union's line in the merkle to the wei.
script/vlCVX/union_reassign/out/*
!script/vlCVX/union_reassign/out/union_end_user_merkle.json
