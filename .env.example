# Copy to .env for local runs. Values are read with dotenv; the pipelines get
# the same values from GitHub secrets, so nothing here is required in CI.

# --- RPC / explorer -------------------------------------------------------
# Read by script/utils/explorerUtils.ts (ETHERSCAN_API_KEY is accepted as a
# fallback for the same key).
EXPLORER_KEY=
# Primary RPC provider; ROUTEMESH and INFURA are used as fallbacks.
WEB3_ALCHEMY_API_KEY=
ROUTEMESH_API_KEY=
INFURA_API_KEY=
# Optional per-chain override, e.g. RPC_URL_1=https://...
RPC_URL_1=

# --- Indexer --------------------------------------------------------------
# GraphQL endpoint for the delegation/forwarder indexer. Required by the
# spectra repartition and forwarder indexing paths.
BOTS_ENVIO_GRAPHQL_URL_WORKER=

# --- Telegram (optional) --------------------------------------------------
# Verification notifications (script/utils/telegramUtils.ts).
TELEGRAM_VERIF_API_KEY=
TELEGRAM_VERIF_CHAT_ID=
# Separate bot used by script/verify/telegramReport.ts when iterating locally.
TEST_TELEGRAM_API_KEY=
TEST_TELEGRAM_CHAT_ID=

# --- IPFS pinning (publish steps only) ------------------------------------
PINATA_JWT=
PINATA_GATEWAY=
PINNING_SERVICE_URL=
PINNING_SERVICE_TOKEN=

# --- Optional behaviour flags --------------------------------------------
# Force regeneration of an existing merkle / round.
FORCE_MERKLE=
FORCE_UPDATE=
# Repartition a period other than the current one (unix timestamp).
VLCVX_TARGET_PERIOD=
# Allow a repartition against a proposal that has not ended yet (fork/vnet).
VLCVX_ALLOW_ACTIVE_PROPOSAL=
# Verbose report logging.
DEBUG_REPORTS=
